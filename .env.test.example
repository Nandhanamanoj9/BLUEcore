# E2E Test Environment Variables — BLU CORE
# Copy this file to .env.test and fill in values for your environment.
# NEVER commit real credentials to git.

# Frontend base URL (default: http://localhost:3000 — matches vite.config.js)
E2E_BASE_URL=http://localhost:3000

# Backend API URL (default: http://localhost:5000/api — matches backend/server.js)
E2E_API_URL=http://localhost:5000/api

# Admin credentials for API-level admin login tests.
# In development/mock mode these match the seeded admin in backend/config/firebase.js.
# In production, use real admin credentials via CI secrets — NEVER hardcode here.
E2E_ADMIN_EMAIL=blucorenc@gmail.com
E2E_ADMIN_PASSWORD=Admin@123456

