# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Firebase Service Account Configuration
# Option A: Individual environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Option B: Path to downloaded Firebase serviceAccountKey.json file
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Admin Authentication
JWT_SECRET=blucore_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Email Notification System
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="BLU CORE" <noreply@blucoredesign.com>
ADMIN_EMAIL=blucorenc@gmail.com
